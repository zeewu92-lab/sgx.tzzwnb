/* ============================================================
   A/B 求籤
============================================================ */
function openAB(){
  document.getElementById('abA').value = '';
  document.getElementById('abB').value = '';
  document.getElementById('abResultBox').innerHTML = '';
  document.getElementById('abModal').classList.remove('hidden');
}
const AB_REASONS = [
  '你的直覺其實早有答案，這一籤只是幫你確認。',
  '有時候選擇本身沒有標準答案，選定了就全力以赴。',
  '這個結果呼應了你內心比較安穩的那個選擇。',
  '不論結果如何，重要的是選定後別再回頭猶豫。',
  '這一籤提醒你，勇敢跨出這一步或許正是時候。'
];
document.getElementById('abDraw').onclick = () => {
  const a = document.getElementById('abA').value.trim() || '選項 A';
  const b = document.getElementById('abB').value.trim() || '選項 B';
  const box = document.getElementById('abResultBox');
  box.innerHTML = '<div class="ab-result"><div class="pick loading-dots">搖籤中</div></div>';
  setTimeout(()=>{
    const pick = Math.random() < 0.5 ? a : b;
    const reason = AB_REASONS[Math.floor(Math.random()*AB_REASONS.length)];
    box.innerHTML = '<div class="ab-result"><div class="pick">「 '+pick+' 」</div><div class="why">'+reason+'</div></div>';
  }, 900);
};

/* ============================================================
   AI 解籤（Claude API）
============================================================ */
function openAI(entry){
  const intro = document.getElementById('aiIntro');
  document.getElementById('aiAnswerBox').innerHTML = '';
  document.getElementById('aiQuestion').value = '';
  if(entry){
    const q = QIAN.find(x=>x.id===entry.qianId);
    intro.textContent = '今日抽到「第 '+q.id+' 籤 · '+levelOf(q)+'」，說說你真正想問的事，讓解籤更貼近你的處境。';
  } else {
    intro.textContent = '今天還沒抽籤，籤師會根據一般籤理給你回應，建議先到「今日」抽一支籤。';
  }
  document.getElementById('aiModal').dataset.entryId = entry ? entry.qianId : '';
  document.getElementById('aiModal').dataset.entryDate = entry ? entry.date : '';
  document.getElementById('aiModal').classList.remove('hidden');
}

document.getElementById('aiAsk').onclick = async () => {
  const modal = document.getElementById('aiModal');
  const qid = modal.dataset.entryId;
  const question = document.getElementById('aiQuestion').value.trim();
  const box = document.getElementById('aiAnswerBox');

  if(!question){
    box.innerHTML = '<div class="ai-answer">請先簡單說說你想問的事，籤師才能給出貼近你處境的解讀喔。</div>';
    return;
  }

  box.innerHTML = '<div class="ai-answer"><span class="loading-dots">籤師正在解籤</span></div>';

  let poemInfo = '（使用者今日尚未抽籤，請以一般籤理與生活智慧回應。）';
  if(qid){
    const q = QIAN.find(x=>x.id===parseInt(qid,10));
    if(q){
      poemInfo = '籤號：第'+q.id+'籤，籤級：'+levelOf(q)+'\n籤詩：'+q.poem.join('，')+'\n白話解釋：'+q.explain+'\n今日建議：'+q.advice;
    }
  }

  const sys = '你是一位溫暖、有智慧、講話溫和不誇張的解籤師。使用者抽到了一支籤，請根據籤詩內容與使用者的提問，給出貼近生活、務實、溫暖的解讀與建議。避免使用「絕對」「保證」等武斷字眼，避免醫療、法律、投資等專業斷言，語氣像一位親切的長輩朋友。回覆請用繁體中文，控制在150字以內，分成「解讀」與「建議」兩小段。';
  const userMsg = '籤文資訊：\n'+poemInfo+'\n\n使用者的問題：'+question;

  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        system: sys,
        messages: [{ role: "user", content: userMsg }]
      })
    });
    const data = await response.json();
    const text = (data.content || []).map(c => c.text || '').join('\n').trim();
    box.innerHTML = '<div class="ai-answer">'+(text || '籤師暫時沒有回應，稍後再試試看。')+'</div>';
  }catch(e){
    box.innerHTML = '<div class="ai-answer">解籤時發生了一點小狀況，請稍後再試一次。</div>';
  }
};

/* ============================================================
   SHARE CARD (canvas)
============================================================ */
function openShare(entry){
  document.getElementById('shareModal').classList.remove('hidden');
  document.fonts.ready.then(()=> drawShareCanvas(entry));
}
function wrapText(ctx, text, maxWidth){
  const lines = [];
  let line = '';
  for(const ch of text){
    const test = line + ch;
    if(ctx.measureText(test).width > maxWidth && line){
      lines.push(line);
      line = ch;
    } else {
      line = test;
    }
  }
  if(line) lines.push(line);
  return lines;
}
function drawShareCanvas(entry){
  const q = QIAN.find(x=>x.id===entry.qianId);
  const lv = levelOf(q);
  const canvas = document.getElementById('shareCanvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;

  // background
  const grad = ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,'#5C1A22');
  grad.addColorStop(1,'#331014');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);

  // border
  ctx.strokeStyle = '#C9A44C';
  ctx.lineWidth = 2;
  ctx.strokeRect(14,14,W-28,H-28);
  ctx.strokeStyle = 'rgba(201,164,76,0.5)';
  ctx.lineWidth = 1;
  ctx.strokeRect(20,20,W-40,H-40);

  // title
  ctx.fillStyle = '#E4C879';
  ctx.font = '700 20px "Noto Serif TC"';
  ctx.textAlign = 'center';
  ctx.fillText('日 籤', W/2, 54);
  ctx.font = '400 11px "Noto Sans TC"';
  ctx.fillStyle = 'rgba(245,236,216,0.6)';
  ctx.fillText(entry.date + ' · 今日籤運', W/2, 72);

  // level badge
  ctx.fillStyle = '#B3282D';
  ctx.fillRect(W/2-46,90,92,30);
  ctx.fillStyle = '#fff5e8';
  ctx.font = '700 15px "Noto Serif TC"';
  ctx.fillText('第 '+q.id+' 籤 · '+lv, W/2, 110);

  // paper block for poem
  ctx.fillStyle = '#F5ECD8';
  ctx.fillRect(40,138,W-80,150);
  ctx.strokeStyle = 'rgba(179,40,45,0.35)';
  ctx.strokeRect(46,144,W-92,138);

  ctx.fillStyle = '#2A211A';
  ctx.font = '700 19px "Noto Serif TC"';
  const colW = (W-100)/4;
  q.poem.forEach((line, i) => {
    const x = 40 + 20 + colW*(3-i) + colW/2;
    let y = 168;
    for(const ch of line){
      ctx.fillText(ch, x, y);
      y += 24;
    }
  });

  // explain
  ctx.fillStyle = '#F5ECD8';
  ctx.font = '400 13px "Noto Sans TC"';
  ctx.textAlign = 'left';
  const explainLines = wrapText(ctx, q.explain, W-80);
  let ey = 318;
  explainLines.forEach(l => { ctx.fillText(l, 40, ey); ey += 20; });

  ctx.fillStyle = '#E4C879';
  ctx.font = '700 12px "Noto Sans TC"';
  ctx.fillText('今日建議', 40, ey+10);
  ctx.fillStyle = '#F5ECD8';
  ctx.font = '400 13px "Noto Sans TC"';
  const adviceLines = wrapText(ctx, q.advice, W-80);
  let ay = ey+32;
  adviceLines.forEach(l => { ctx.fillText(l, 40, ay); ay += 20; });

  // stars
  ctx.textAlign = 'center';
  ctx.font = '400 20px sans-serif';
  const stars = entry.stats.overall;
  let starStr = '';
  for(let i=1;i<=5;i++) starStr += (i<=stars?'★':'☆');
  ctx.fillStyle = '#E4C879';
  ctx.fillText(starStr, W/2, H-46);
  ctx.font = '400 10px "Noto Sans TC"';
  ctx.fillStyle = 'rgba(245,236,216,0.5)';
  ctx.fillText('綜合運勢 · 日籤 daily-qian', W/2, H-24);
}
document.getElementById('downloadShare').onclick = () => {
  const canvas = document.getElementById('shareCanvas');
  const link = document.createElement('a');
  link.download = '今日籤運-'+todayStr()+'.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
};

/* ============================================================
   NAV / MODAL WIRING
============================================================ */
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.onclick = () => {
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('view-'+btn.dataset.tab).classList.add('active');
    if(btn.dataset.tab === 'book') renderBook();
    if(btn.dataset.tab === 'more') renderMore();
  };
});
document.querySelectorAll('[data-close]').forEach(btn=>{
  btn.onclick = () => document.getElementById(btn.dataset.close).classList.add('hidden');
});

/* ============================================================
   INIT
============================================================ */
(async function init(){
  await loadHistory();
  renderToday();
})();

})();
