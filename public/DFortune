function todayStr(){
  const d = new Date();
  const p = n => String(n).padStart(2,'0');
  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate());
}
function todayDisplay(){
  const d = new Date();
  return (d.getMonth()+1)+'月'+d.getDate()+'日';
}
function hashStr(str){
  let h = 0;
  for(let i=0;i<str.length;i++){ h = (h*31 + str.charCodeAt(i)) | 0; }
  return Math.abs(h);
}
function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }

function computeStats(q){
  const base = baseStars(q);
  const stats = {overall: base};
  CATS.forEach(c=>{
    const off = (hashStr(q.id + c.key) % 3) - 1; // -1,0,1
    stats[c.key] = clamp(base + off, 1, 5);
  });
  return stats;
}
function catAdviceFor(q, catKey){
  const bank = CAT_ADVICE[catKey][starTier(q)];
  const idx = hashStr(q.id + catKey + 'adv') % bank.length;
  return bank[idx];
}
function todayQuote(){
  const start = new Date(new Date().getFullYear(),0,0);
  const diff = new Date() - start;
  const dayOfYear = Math.floor(diff / 86400000);
  return QUOTES[dayOfYear % QUOTES.length];
}

