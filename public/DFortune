        + q.poem.map(line=>'<div class="poem-line">'+line+'</div>').join('')
      + '</div>'
      + '<div class="qian-section"><h4>白話解釋</h4><p>'+q.explain+'</p></div>'
      + '<div class="qian-section"><h4>今日建議</h4><p>'+q.advice+'</p></div>'
    + '</div>'
    + '<div class="overall-stars">'+starsHTML(stats.overall,26)+'<div class="overall-label">綜合運勢</div></div>'
    + '<div class="cat-list">'+catRows+'</div>'
    + focusAdviceLine;
}

function renderToday(){
  const el = document.getElementById('view-today');
  const entry = todayEntry();

  if(!entry){
    el.innerHTML = ''
      + '<div class="eyebrow">'+todayDisplay()+' · 尚未抽籤</div>'
      + '<div class="chip-row" id="focusChips"></div>'
      + '<div class="tube-stage">'
        + '<div class="tube-wrap" id="tubeTap">'
          + '<div class="sticks">'
            + [-26,-16,-6,4,14,24].map(r=>'<div class="stick" style="transform:translateX(-50%) rotate('+r+'deg)"></div>').join('')
          + '</div>'
          + '<div class="tube"></div>'
          + '<div class="tube-label">求 籤</div>'
        + '</div>'
        + '<p class="tube-hint">誠心默想想問的事，輕點<b>籤筒</b>抽出今日籤</p>'
        + '<button class="btn btn-primary" id="drawBtn" style="max-width:220px; margin-top:6px;">點 我 抽 籤</button>'
      + '</div>'
      + '<div class="quote-card"><p>「'+todayQuote()+'」</p><span>每 日 一 句</span></div>';

    renderFocusChips();
    document.getElementById('tubeTap').onclick = beginDraw;
    document.getElementById('drawBtn').onclick = beginDraw;
  } else {
    el.innerHTML = ''
      + '<div class="eyebrow">'+todayDisplay()+' · 今日籤文</div>'
      + renderResultBody(entry)
      + '<div class="btn-row">'
        + '<button class="btn btn-gold" id="shareBtn">生成分享卡</button>'
        + '<button class="btn btn-ghost" id="aiBtnToday">AI 解籤</button>'
      + '</div>'
      + '<div class="done-banner">今日已抽過籤，明日再來求一籤</div>'
      + '<div class="quote-card"><p>「'+todayQuote()+'」</p><span>每 日 一 句</span></div>';

    document.getElementById('shareBtn').onclick = () => openShare(entry);
    document.getElementById('aiBtnToday').onclick = () => openAI(entry);
  }
}

function renderFocusChips(){
  const wrap = document.getElementById('focusChips');
  if(!wrap) return;
  wrap.innerHTML = FOCUS_CATS.map(f =>
    '<button class="chip'+(focusCategory===f.key?' active':'')+'" data-focus="'+f.key+'">'+f.label+'</button>'
  ).join('');
  wrap.querySelectorAll('.chip').forEach(btn=>{
    btn.onclick = () => { focusCategory = btn.dataset.focus; renderFocusChips(); };
  });
}

/* ============================================================
   DRAW RITUAL
============================================================ */
let drawTimers = [];
function clearDrawTimers(){ drawTimers.forEach(t=>clearTimeout(t)); drawTimers = []; }

function beginDraw(){
  if(todayEntry()) return;
  const overlay = document.getElementById('drawOverlay');
  const stage = document.getElementById('drawStage');
  const sticksWrap = document.getElementById('riteSticks');
  const flying = document.getElementById('flyingStick');
  const caption = document.getElementById('drawCaption');

  // build rite sticks
  sticksWrap.innerHTML = [-30,-20,-10,0,10,20,30].map(r=>
    '<div class="rite-stick" style="--r:'+r+'deg; left:calc(50% + '+(r*1.1)+'px)"></div>'
  ).join('');

  flying.className = 'flying-stick';
  flying.style.transition = 'none';
  overlay.classList.remove('hidden');
  stage.classList.add('shaking');
  caption.textContent = '搖籤中…';

  const q = QIAN[Math.floor(Math.random()*QIAN.length)];
  const lv = levelOf(q);
  document.getElementById('fsNo').textContent = '第 '+q.id+' 籤';
  document.getElementById('fsLevel').textContent = lv;

  function finishNow(){
    clearDrawTimers();
    completeDraw(q);
  }
  document.getElementById('skipDraw').onclick = finishNow;

  drawTimers.push(setTimeout(()=>{
    stage.classList.remove('shaking');
    caption.textContent = '一籤躍出…';
    requestAnimationFrame(()=>{
      flying.style.transition = '';
      flying.classList.add('rise');
    });
  }, 1200));

  drawTimers.push(setTimeout(()=>{
    caption.textContent = '緣分已定';
    flying.classList.add('flip');
  }, 1900));

  drawTimers.push(setTimeout(()=>{
    completeDraw(q);
  }, 2600));
}

function completeDraw(q){
  const overlay = document.getElementById('drawOverlay');
  overlay.classList.add('hidden');
  const entry = {
    date: todayStr(),
    qianId: q.id,
    focus: focusCategory,
    stats: computeStats(q),
    ts: Date.now()
  };
  history.unshift(entry);
  saveHistory();
  renderToday();
}

/* ============================================================
   RENDER — BOOK VIEW
============================================================ */
function renderBook(){
  const el = document.getElementById('view-book');
  if(history.length === 0){
    el.innerHTML = '<div class="empty-state"><span class="glyph">📜</span>還沒有抽過籤<br>到「今日」抽第一支籤吧</div>';
    return;
  }
  const rows = history.map((h,idx) => {
    const q = QIAN.find(x=>x.id===h.qianId);
    const lv = levelOf(q);
    return '<div class="book-item" data-idx="'+idx+'">'
      + '<div class="book-left"><div class="book-date">'+h.date+'</div><div class="book-title">第 '+q.id+' 籤 · '+q.poem[0]+'</div></div>'
      + '<div class="level-badge lv-'+lv+'" style="font-size:12px; padding:5px 10px;">'+lv+'</div>'
      + '</div>';
  }).join('');
  el.innerHTML = '<div class="eyebrow">籤 冊 · 共 '+history.length+' 筆紀錄</div>' + rows
    + '<div style="text-align:center; margin-top:20px;"><button class="btn btn-ghost" id="clearHistBtn" style="font-size:12px; padding:8px 16px;">清除全部紀錄</button></div>';

  el.querySelectorAll('.book-item').forEach(item=>{
    item.onclick = () => openDetail(history[parseInt(item.dataset.idx,10)]);
  });
  document.getElementById('clearHistBtn').onclick = async () => {
    if(confirm('確定要清除全部抽籤紀錄嗎？此動作無法復原。')){
      history = [];
      await saveHistory();
      renderBook();
      renderToday();
    }
  };
}

function openDetail(entry){
  currentDetailEntry = entry;
  const content = document.getElementById('detailContent');
  content.innerHTML = '<div class="eyebrow" style="margin-top:2px;">'+entry.date+'</div>'
    + renderResultBody(entry)
    + '<div class="btn-row">'
      + '<button class="btn btn-gold" id="detailShareBtn">生成分享卡</button>'
      + '<button class="btn btn-ghost" id="detailAiBtn">AI 解籤</button>'
    + '</div>';
  document.getElementById('detailModal').classList.remove('hidden');
  document.getElementById('detailShareBtn').onclick = () => openShare(entry);
  document.getElementById('detailAiBtn').onclick = () => openAI(entry);
}

/* ============================================================
   RENDER — MORE VIEW
============================================================ */
