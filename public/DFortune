const LEVEL_BY_TIER = {good:null, mid:'中籤', bad:'下籤', worst:'下下籤'}; // good split below
function levelOf(q){
  if(q.tier==='good') return q.id<=8 ? '上上籤' : '上籤';
  if(q.tier==='mid') return '中籤';
  if(q.tier==='bad') return '下籤';
  return '下下籤';
}
function baseStars(q){
  const lv = levelOf(q);
  return {'上上籤':5,'上籤':4,'中籤':3,'下籤':2,'下下籤':1}[lv];
}
function starTier(q){
  const lv = levelOf(q);
  if(lv==='上上籤'||lv==='上籤') return 'good';
  if(lv==='中籤') return 'mid';
  return 'bad';
}

